---
const { showSidebarButton = true, version = "latest" } = Astro.props;
---

<nav
	class="fixed w-full top-0 h-12 border-b border-c-border-1 border-dashed bg-c-nav-bg backdrop-blur-md z-20"
>
	<div class="container mx-auto h-full w-full grid grid-cols-[auto_3rem]">
		<div class="flex items-center">
			{
				showSidebarButton && (
					<button
						id="sidebar-toggle"
						class="w-12 h-full lg:hidden flex items-center justify-center hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
						aria-label="Open sidebar"
					>
						<i class="ph-bold ph-list text-xl" />
					</button>
				)
			}

			<a href="/" class="px-4 flex gap-2 items-center min-w-0">
				<img
					class="inline-block h-8 lg:h-10 flex-shrink-0"
					src="/img/thp_logo_exp.svg"
					alt="thp"
				/>
			</a>
			<a
				href={`/en/${version}/learn/`}
				class="inline-block px-2 lg:px-4 text-sm lg:text-base hover:underline whitespace-nowrap"
			>
				Learn
			</a>
			<a
				href={`/en/${version}/api/std/`}
				class="inline-block px-2 lg:px-4 text-sm lg:text-base hover:underline"
			>
				<span class="hidden sm:inline-block"
					>Standard Library</span
				>
				<span class="inline-block sm:hidden">std</span>
			</a>
			<a
				href={`/en/${version}/spec/`}
				class="inline-block px-2 lg:px-4 font-bold text-sm lg:text-base hover:underline"
			>
				<span class="hidden sm:inline-block"
					>Language spec</span
				>
				<span class="inline-block sm:hidden">Spec</span>
			</a>
		</div>

		<div class="flex items-center"></div>
	</div>
</nav>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const sidebar = document.getElementById("sidebar");
		const sidebarToggle = document.getElementById("sidebar-toggle");
		const sidebarBackdrop = document.getElementById("sidebar-backdrop");
		const sidebarClose = document.getElementById("sidebar-close");

		if (!sidebar || !sidebarToggle) {
			console.log(
				"Sidebar or Sidebar toggle not found. Not enabling sidebar on mobile",
			);
			return;
		}

		// Function to open sidebar
		function openSidebar() {
			sidebar.classList.remove("-translate-x-80");
			if (sidebarBackdrop) {
				sidebarBackdrop.classList.remove("opacity-0", "pointer-events-none");
				sidebarBackdrop.classList.add("opacity-100", "pointer-events-auto");
			}
			// Prevent body scroll when sidebar is open
			document.body.style.overflow = "hidden";
			document.body.classList.add("sidebar-open");
		}

		// Function to close sidebar
		function closeSidebar() {
			sidebar.classList.add("-translate-x-80");
			if (sidebarBackdrop) {
				sidebarBackdrop.classList.add("opacity-0", "pointer-events-none");
				sidebarBackdrop.classList.remove("opacity-100", "pointer-events-auto");
			}
			// Restore body scroll
			document.body.style.overflow = "";
			document.body.classList.remove("sidebar-open");
		}

		// Toggle sidebar when hamburger button is clicked
		sidebarToggle.addEventListener("click", () => {
			const isOpen = !sidebar.classList.contains("-translate-x-80");
			if (isOpen) {
				closeSidebar();
			} else {
				openSidebar();
			}
		});

		// Close sidebar when close button is clicked
		if (sidebarClose) {
			sidebarClose.addEventListener("click", closeSidebar);
		}

		// Close sidebar when backdrop is clicked
		if (sidebarBackdrop) {
			sidebarBackdrop.addEventListener("click", closeSidebar);
		}

		// Close sidebar on escape key
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !sidebar.classList.contains("-translate-x-80")) {
				closeSidebar();
			}
		});

		// Close sidebar when clicking on a link (on mobile)
		sidebar.addEventListener("click", (e) => {
			if (e.target instanceof HTMLAnchorElement && window.innerWidth < 1024) {
				closeSidebar();
			}
		});

		// Handle window resize - close sidebar if resizing to desktop
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 1024) {
				closeSidebar();
			}
		});
	});
</script>
