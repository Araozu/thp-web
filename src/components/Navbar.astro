---
const { showSidebarButton = true, version = "latest" } = Astro.props;
---

<nav
	class="fixed w-full top-0 h-12 border-b border-c-border-1 border-dashed bg-c-nav-bg backdrop-blur-md z-20"
>
	<div class="container mx-auto h-full w-full grid grid-cols-[auto_3rem]">
		<div class="flex items-center">
			{
				showSidebarButton && (
					<button
						id="sidebar-toggle"
						class="w-10 h-full lg:hidden"
					>
						<i class="ph-bold ph-list text-xl inline-block" />
					</button>
				)
			}

			<a href="/" class="px-4 flex gap-2 items-center">
				<img
					class="inline-block h-10"
					src="/img/thp_logo_exp.svg"
					alt="thp"
				/>
			</a>
			<a
				href={`/en/${version}/learn/`}
				class="inline-block px-4 font-bold-text-xl hover:underline"
			>
				Learn
			</a>
			<a
				href={`/en/${version}/api/std/`}
				class="inline-block px-4 font-bold-text-xl hover:underline"
			>
				<span class="hidden sm:inline-block"
					>Standard Library</span
				>
				<span class="inline-block sm:hidden">std</span>
			</a>
			<a
				href={`/en/${version}/spec/`}
				class="inline-block px-4 font-bold-text-xl hover:underline"
			>
				<span class="hidden sm:inline-block"
					>Language spec</span
				>
				<span class="inline-block sm:hidden">Spec</span>
			</a>
		</div>

		<div class="flex items-center"></div>
	</div>
</nav>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const sidebar = document.getElementById("sidebar");
		const sidebarToggle = document.getElementById("sidebar-toggle");

		if (!sidebar || !sidebarToggle) {
			console.log(
				"Sidebar or Sidebar toggle not found. Not enabling sidebar on mobile",
			);
			return;
		}

		sidebarToggle.addEventListener("click", () => {
			sidebar.classList.toggle("-translate-x-64");
			console.log(
				sidebar.classList.contains("-translate-x-64"),
			);
		});
	});
</script>
